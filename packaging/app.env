# Single source of truth for names and versions. Every script in packaging/ and
# Scripts/ sources this file, so renaming the app is a one-file edit.
# Plain KEY="value" lines only: bash sources it and prepare_runtime.py parses it.

# SwiftPM product name (Package.swift). Changes only if the product is renamed.
EXECUTABLE_NAME="BluRayCompressor"

# Shown in Finder, the Dock and the DMG volume. The .app folder uses this name.
# PLACEHOLDER: the app is being renamed.
DISPLAY_NAME="Blu-ray Compressor"

# PLACEHOLDER slug: pick the final one with the new name. Nested tools are
# signed with identifiers derived from it (BUNDLE_ID.ffmpeg and so on).
BUNDLE_ID="com.mindinmotion.bluray-compressor"

# File-name stem for release artifacts: <DIST_BASENAME>-<VERSION>-arm64.dmg
DIST_BASENAME="Blu-ray-Compressor"

VERSION="0.2.0"
BUILD_NUMBER="1"
MIN_MACOS="13.0"

COPYRIGHT="Copyright (C) 2026 MindInMotion LLC. Licensed under GPL-3.0."

# Where the GPL corresponding-source archive is published (written source
# offer inside the app points here). PLACEHOLDER until the public repo exists.
SOURCE_URL="https://example.invalid/REPLACE-WITH-RELEASE-PAGE"

# notarytool keychain profile. NOTARY_PROFILE in the environment wins; then
# this value; then backlot-notary (the MindInMotion team profile).
NOTARY_PROFILE_DEFAULT="backlot-notary"
